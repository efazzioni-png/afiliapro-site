# =============================================================================
#  CIA ESTÉTICA — VARIÁVEIS DE AMBIENTE
# =============================================================================
#  Copie este arquivo para `.env.local` e preencha o que for necessário.
#  NUNCA versione o `.env.local` (já está no .gitignore).
#
#  Tudo aqui é opcional: sem nenhuma variável o site funciona, usando os
#  valores padrão de `data/site.ts`.
# =============================================================================

# --- Domínio -----------------------------------------------------------------
# Usado em canonical, Open Graph, sitemap.xml e JSON-LD. Sem barra no final.
NEXT_PUBLIC_SITE_URL=https://ciaestetica.com

# Preencha SOMENTE se o site for servido em um subdiretório
# (ex.: usuario.github.io/cia-estetica → /cia-estetica). Em domínio próprio, deixe vazio.
NEXT_PUBLIC_BASE_PATH=

# --- Contato -----------------------------------------------------------------
# ⚠️ OBRIGATÓRIO ANTES DE PUBLICAR: WhatsApp oficial.
# Formato internacional, apenas dígitos: 55 + DDD + número.
# Exemplo: 5521999998888
NEXT_PUBLIC_WHATSAPP_NUMBER=

# E-mail oficial. Se ficar vazio, o campo simplesmente não aparece no site.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Formulário de contato ---------------------------------------------------
# Vazio  → o formulário monta a mensagem e abre o WhatsApp (não precisa de back-end).
# Preenchido → o formulário envia um POST em JSON para esta URL.
# Funciona com Formspree, Getform, n8n, Make, ou uma API própria.
NEXT_PUBLIC_FORM_ENDPOINT=

# --- Redes sociais -----------------------------------------------------------
# URL completa. Um campo vazio NÃO é renderizado (nada falso aparece no site).
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=

# --- Loja / e-commerce -------------------------------------------------------
# Ao preencher, TODOS os botões de produto passam a apontar para a loja.
# Vazio → os botões levam ao WhatsApp.
NEXT_PUBLIC_STORE_URL=

# --- Analytics e campanhas ---------------------------------------------------
# Sem ID, o script correspondente nem é carregado (melhor performance e LGPD).
NEXT_PUBLIC_GA_ID=              # Google Analytics 4  — formato G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=             # Google Tag Manager  — formato GTM-XXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=      # Google Ads          — formato AW-XXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=      # Meta Pixel          — apenas números

# --- Desenvolvimento ---------------------------------------------------------
# true → exibe marcações internas de conteúdo pendente. Deixe vazio em produção.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=
